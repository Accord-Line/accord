{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/psw/schemas/product-spec.schema.json",
  "title": "PSW Product Specification IR (draft v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "revision",
    "intent",
    "requirements",
    "experiences",
    "tests",
    "decisions",
    "history",
    "evidence",
    "unstructuredNotes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "sourceUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "experiences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experience"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "unstructuredNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "status",
        "constraints",
        "acceptanceCriteria",
        "experienceIds",
        "testIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/objectId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "deprecated"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "experienceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectId"
          }
        },
        "testIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectId"
          }
        }
      }
    },
    "objectId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,80}$"
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "requirementIds",
        "state",
        "components",
        "events"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/objectId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectId"
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "stateKey",
        "props"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/objectId"
        },
        "type": {
          "enum": [
            "text",
            "card",
            "button",
            "textInput",
            "numberInput",
            "select",
            "slider",
            "switch",
            "statusMessage"
          ]
        },
        "label": {
          "type": "string"
        },
        "stateKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "props": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "placeholder": {
              "type": "string"
            },
            "hoverLiftPx": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "durationMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 1200
            }
          },
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "minLength": {
              "type": "integer",
              "minimum": 0
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "event",
        "actions"
      ],
      "properties": {
        "componentId": {
          "$ref": "#/$defs/objectId"
        },
        "event": {
          "enum": [
            "click",
            "change",
            "hoverStart",
            "hoverEnd"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "stateKey",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "setState"
            },
            "stateKey": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "stateKey"
          ],
          "properties": {
            "kind": {
              "const": "toggleState"
            },
            "stateKey": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "message"
          ],
          "properties": {
            "kind": {
              "const": "showMessage"
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "stateKeys"
          ],
          "properties": {
            "kind": {
              "const": "validateFields"
            },
            "stateKeys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirementId",
        "title",
        "procedure",
        "expected",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/objectId"
        },
        "requirementId": {
          "$ref": "#/$defs/objectId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "procedure": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "status": {
          "enum": [
            "not-run",
            "passed-local-scenario",
            "failed-local-scenario",
            "external-verified"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "rationale",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/objectId"
        },
        "summary": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "summary",
        "source"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string"
        },
        "source": {
          "enum": [
            "import",
            "manual",
            "ai-approved",
            "rollback"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relatedId",
        "category",
        "status",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/objectId"
        },
        "relatedId": {
          "$ref": "#/$defs/objectId"
        },
        "category": {
          "enum": [
            "schema",
            "reference",
            "scenario",
            "external-implementation"
          ]
        },
        "status": {
          "enum": [
            "not-run",
            "pass",
            "fail"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
