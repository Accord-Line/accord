{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/psw/schemas/ai-proposal.schema.json",
  "title": "PSW Change Proposal (draft v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposalId",
    "baseRevision",
    "summary",
    "rationale",
    "risks",
    "operations"
  ],
  "properties": {
    "proposalId": {
      "type": "string",
      "pattern": "^CR-[A-Z0-9-]+$"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "requirement"
            ],
            "properties": {
              "op": {
                "const": "addRequirement"
              },
              "requirement": {
                "$ref": "product-spec.schema.json#/$defs/requirement"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "fields"
            ],
            "properties": {
              "op": {
                "const": "updateRequirement"
              },
              "id": {
                "$ref": "product-spec.schema.json#/$defs/objectId"
              },
              "fields": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "draft",
                      "approved",
                      "deprecated"
                    ]
                  },
                  "constraints": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "acceptanceCriteria": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "experienceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "testIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "experience"
            ],
            "properties": {
              "op": {
                "const": "addExperience"
              },
              "experience": {
                "$ref": "product-spec.schema.json#/$defs/experience"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "fields"
            ],
            "properties": {
              "op": {
                "const": "updateExperience"
              },
              "id": {
                "$ref": "product-spec.schema.json#/$defs/objectId"
              },
              "fields": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "requirementIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "state": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "components": {
                    "type": "array",
                    "items": {
                      "$ref": "product-spec.schema.json#/$defs/component"
                    }
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "$ref": "product-spec.schema.json#/$defs/event"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "test"
            ],
            "properties": {
              "op": {
                "const": "addTest"
              },
              "test": {
                "allOf": [
                  {
                    "$ref": "product-spec.schema.json#/$defs/test"
                  },
                  {
                    "properties": {
                      "status": {
                        "const": "not-run"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "fields"
            ],
            "properties": {
              "op": {
                "const": "updateTest"
              },
              "id": {
                "$ref": "product-spec.schema.json#/$defs/objectId"
              },
              "fields": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "procedure": {
                    "type": "string"
                  },
                  "expected": {
                    "type": "string"
                  },
                  "status": {
                    "const": "not-run"
                  }
                }
              }
            }
          },
          {
            "required": [
              "op",
              "markdown"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "updateDocument"
              },
              "markdown": {
                "minLength": 1,
                "type": "string",
                "maxLength": 200000
              }
            },
            "type": "object"
          }
        ]
      }
    }
  },
  "$comment": "Proposal protocol 0.2 adds updateDocument; v0.1 operations remain valid. Canonical product schema stays 0.1.0."
}