{
  "name": "accord-workspace",
  "private": true,
  "version": "0.3.0-preview",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run check:types && npm run typecheck && vite build",
    "build:pages": "npm run build -- --base=/accord/",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "jszip": "^3.10.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "license": "Apache-2.0",
  "homepage": "https://accord-line.github.io/accord/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Accord-Line/accord.git"
  },
  "bugs": {
    "url": "https://github.com/Accord-Line/accord/issues"
  }
}
